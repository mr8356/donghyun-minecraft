{
  "title": "Minecraft - Logs & Activity",
  "uid": "minecraft-logs",
  "schemaVersion": 39,
  "version": 3,
  "editable": true,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "app",
        "label": "Server",
        "type": "custom",
        "query": "Bedrock : bedrock",
        "current": { "text": "Bedrock", "value": "bedrock" },
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Online Players",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green", "value": null } ] } } },
      "targets": [
        { "expr": "sum(mc_status_players_online)", "legendFormat": "online" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Server Healthy",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus" },
      "options": { "colorMode": "background" },
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } } ] } },
      "targets": [
        { "expr": "min(mc_status_healthy)", "legendFormat": "healthy" }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Response Time",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 100 }, { "color": "red", "value": 300 } ] }
        }
      },
      "targets": [
        { "expr": "mc_status_response_time_ms", "legendFormat": "latency" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Log Volume by Level",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "loki" },
      "targets": [
        { "expr": "sum by (level) (count_over_time({namespace=\"minecraft\", app=~\"$app\"} [1m]))", "legendFormat": "{{level}}" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Player Join / Leave",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "loki" },
      "targets": [
        { "expr": "sum(count_over_time({namespace=\"minecraft\", app=~\"$app\"} |~ \"Player connected:\" [5m]))", "legendFormat": "join" },
        { "expr": "sum(count_over_time({namespace=\"minecraft\", app=~\"$app\"} |~ \"Player disconnected:\" [5m]))", "legendFormat": "leave" }
      ]
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Errors & Warnings",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" },
      "targets": [
        { "expr": "{namespace=\"minecraft\", app=~\"$app\"} |~ \"WARN|ERROR\"" }
      ]
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Live Server Log",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 11 },
      "datasource": { "type": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true },
      "targets": [
        { "expr": "{namespace=\"minecraft\", app=~\"$app\"}" }
      ]
    }
  ]
}
